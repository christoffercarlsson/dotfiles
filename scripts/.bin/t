#!/usr/bin/env bash
set -euo pipefail

session=$(basename "$PWD")

if [ -n "${TMUX:-}" ]; then
    if ! tmux has-session -t "$session" 2>/dev/null; then
        tmux new-session -d -s "$session"
    fi
    exec tmux switch-client -t "$session"
else
    if tmux has-session -t "$session" 2>/dev/null; then
        exec tmux attach -t "$session"
    else
        exec tmux new-session -s "$session"
    fi
fi
