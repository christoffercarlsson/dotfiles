#!/usr/bin/env bash
set -euo pipefail

fish_path=$(command -v fish)

if ! [[ -x "$fish_path" ]]; then
    echo "Fish not found" >&2
    exit 1
fi

if ! grep -qx "$fish_path" /etc/shells; then
    sudo sh -c "echo '$fish_path' >> /etc/shells"
fi

if ! chsh -s "$fish_path"; then
    echo "Failed to set Fish as default shell" >&2
    exit 1
fi

echo "Fish is now the default login shell"
