#!/usr/bin/env bash

set -eo pipefail

usage() {
    cat <<EOF
Usage: $0 [options]

Options:
  --name NAME       Name to use for the Git user
  --email EMAIL     Email address to use for the Git user
  --allowed-signers PATH
                    Verify signatures against the signers listed in PATH, or in
                    PATH/.allowed_signers if PATH is a directory
  --directory PATH  Use the credentials only for repositories under PATH,
                    storing them in PATH/.gitconfig.local
  --sign-commits    Sign commits
  --no-sign-commits Do not sign commits (default)
EOF
}

error() {
    echo "Error: $*" >&2
    exit 1
}

set_credentials() {
    local allowed_signers=""
    local directory=""
    local email=""
    local name=""
    local sign_commits=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
        -h | --help)
            usage
            exit 0
            ;;
        -n | --name)
            name="$2"
            shift 2
            ;;
        -e | --email)
            email="$2"
            shift 2
            ;;
        -a | --allowed-signers | --allowed-signers-file)
            allowed_signers="$2"
            shift 2
            ;;
        -d | --directory | --dir)
            directory="$2"
            shift 2
            ;;
        -s | --sign-commits)
            sign_commits="yes"
            shift
            ;;
        -S | --no-sign-commits)
            sign_commits="no"
            shift
            ;;
        -*) error "unknown option: $1" ;;
        *) error "unexpected argument: $1" ;;
        esac
    done

    local base="$HOME/.gitconfig.local"
    local file="$base"

    if [[ -n "$directory" ]]; then
        [[ -d "$directory" ]] || error "$directory is not a directory"

        directory="$(cd "$directory" && pwd -P)"

        if [[ ! "$directory" -ef "$HOME" ]]; then
            file="$directory/.gitconfig.local"
        fi
    fi

    if [[ -n "$allowed_signers" ]]; then
        if [[ -d "$allowed_signers" ]]; then
            allowed_signers="$allowed_signers/.allowed_signers"
        fi

        [[ -f "$allowed_signers" ]] || error "$allowed_signers is not a file"

        allowed_signers="$(cd "$(dirname "$allowed_signers")" && pwd -P)/$(basename "$allowed_signers")"
    fi

    git config --file "$base" gpg.format ssh
    git config --file "$base" gpg.ssh.defaultKeyCommand "ssh-add -L"
    git config --file "$base" tag.gpgsign true

    if [[ "$file" != "$base" ]]; then
        git config --file "$base" "includeIf.gitdir:$directory/.path" "$file"
    fi

    if [[ -n "$name" ]]; then
        git config --file "$file" user.name "$name"
    fi

    if [[ -n "$email" ]]; then
        git config --file "$file" user.email "$email"
    fi

    if [[ -n "$allowed_signers" ]]; then
        git config --file "$file" gpg.ssh.allowedSignersFile "$allowed_signers"
    fi

    if [[ -z "$sign_commits" && "$file" == "$base" ]]; then
        sign_commits="no"
    fi

    if [[ "$sign_commits" == "yes" ]]; then
        git config --file "$file" commit.gpgsign true
    elif [[ "$sign_commits" == "no" ]]; then
        git config --file "$file" commit.gpgsign false
    fi
}

set_credentials "$@"
