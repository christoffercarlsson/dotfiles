#!/usr/bin/env bash

set -eo pipefail

usage() {
    cat <<EOF
Usage: $0 [options] <name> <email>

Options:
  --sign-commits    Sign commits (enabled by default)
  --no-sign-commits Do not sign commits

Arguments:
  name              Name to use for the Git user
  email             Email address to use for the Git user
EOF
}

error() {
    echo "Error: $*" >&2
    exit 1
}

set_credentials() {
    local args=()
    local sign_commits="yes"

    while [[ $# -gt 0 ]]; do
        case "$1" in
        -h | --help)
            usage
            exit 0
            ;;
        -s | --sign-commits)
            sign_commits="yes"
            shift
            ;;
        -S | --no-sign-commits)
            sign_commits="no"
            shift
            ;;
        --)
            shift
            args+=("$@")
            break
            ;;
        -*) error "unknown option: $1" ;;
        *)
            args+=("$1")
            shift
            ;;
        esac
    done

    set -- "${args[@]}"

    local name="$1"
    local email="$2"

    [[ -z "$name" ]] && error "missing argument: name"
    [[ -z "$email" ]] && error "missing argument: email"

    local file="$HOME/.gitconfig.local"

    git config --file "$file" user.name "$name"
    git config --file "$file" user.email "$email"

    git config --file "$file" gpg.format ssh
    git config --file "$file" gpg.ssh.defaultKeyCommand "ssh-add -L"
    git config --file "$file" tag.gpgsign true

    if [[ "$sign_commits" == "yes" ]]; then
        git config --file "$file" commit.gpgsign true
    else
        git config --file "$file" commit.gpgsign false
    fi
}

set_credentials "$@"
