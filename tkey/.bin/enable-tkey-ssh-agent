#!/usr/bin/env bash

set -eo pipefail

write_tkey_config() {
    if ! command -v brew >/dev/null; then
        error "brew not installed"
    fi

    if ! command -v tkey-ssh-agent >/dev/null; then
        error "tkey-ssh-agent not installed"
    fi

    local socket
    socket="$(brew --prefix)/var/run/tkey-ssh-agent.sock"

    local line="export SSH_AUTH_SOCK=\"$socket\""

    append_line "$line" ~/.bash.local
    append_line "$line" ~/.zsh.local

    line="set -gx SSH_AUTH_SOCK \"$socket\""

    append_line "$line" ~/.fish.local
}

error() {
    echo "Error: $*" >&2
    exit 1
}

append_line() {
    local line=$1
    local file=$2

    if ! grep -qxF -- "$line" "$file" 2>/dev/null; then
        printf '%s\n' "$line" >>"$file"
    fi
}

write_tkey_config "$@"
