#!/usr/bin/env bash

set -eo pipefail

install_chprog() {
    if ! command -v brew >/dev/null; then
        error "brew not installed"
    fi

    if ! brew --prefix --installed libusb >/dev/null 2>&1; then
        error "libusb not installed"
    fi

    local repository="https://github.com/ole00/chprog"
    local branch="main"
    local program="chprog"
    local destination="$HOME/.bin"

    local workspace
    workspace="$(mktemp -d)"

    trap 'rm -rf "$workspace"' EXIT

    git clone --quiet --depth 1 --branch "$branch" "$repository" "$workspace" ||
        error "failed to clone $repository"

    (cd "$workspace" && sh ./build_macos.sh) >/dev/null 2>&1 ||
        error "failed to build $program"

    install -m 755 "$workspace/$program" "$destination/$program"
}

error() {
    echo "Error: $*" >&2
    exit 1
}

install_chprog "$@"
